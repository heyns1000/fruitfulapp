# Example environment configuration for the Fruitful app.
# Copy to `.env.local` (git-ignored) and fill in real values. Do NOT commit real
# values. Anything prefixed with VITE_ is bundled into the client and is PUBLIC —
# only put publishable / client-safe identifiers here.

# --- Client-safe, publishable identifiers (shown in the CodeNest API Key panel) ---
# PayPal client-side SDK client ID
VITE_PAYPAL_CLIENT_ID=
# PayPal hosted-button IDs (public, embedded in checkout buttons)
VITE_PAYPAL_BUTTON_STARTER=
VITE_PAYPAL_BUTTON_PRO=
VITE_PAYPAL_BUTTON_ENTERPRISE=
# Google Maps JavaScript API browser key (restrict by HTTP referrer in the Google console)
VITE_GOOGLE_MAPS_KEY=
# Xero OAuth 2.0 client ID (publishable identifier, not the secret)
VITE_XERO_CLIENT_ID=

# --- BACKEND-ONLY SECRETS: never put these in VITE_ vars or any client code ---
# A VITE_ variable is compiled into the public bundle, so it is NOT a safe place
# for a secret. The following belong only in server-side environment config:
#   - Xero Client Secret
#   - Xero Webhook Key
#   - Gemini API key
# e.g. (server env, NOT VITE_):
# XERO_CLIENT_SECRET=
# XERO_WEBHOOK_KEY=
# GEMINI_API_KEY=
