{
  "name": "Daily Sheet Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "Africa/Johannesburg",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_sheet_sync",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_sheet": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scheduledSheetSync",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Google Sheet",
            "description": "Daily 2 AM sync: Brands, Coffee, Food Menu, BlockVault"
          }
        }
      }
    ]
  },
  "description": "Every day at 2 AM (Johannesburg), discovers all tabs in the configured Google Sheet and syncs them into the matching entities \u2014 Brand financials, CoffeeCostInput, FoodMenuItem, and BarcodeMapping \u2014 so the Fruitful Coffee and BlockVault dashboards stay current without manual refresh."
}