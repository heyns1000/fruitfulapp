{
  "name": "Review",
  "type": "object",
  "properties": {
    "artisanId": {
      "type": "string",
      "description": "The artisan being reviewed"
    },
    "artisanName": {
      "type": "string"
    },
    "productId": {
      "type": "string",
      "description": "Optional - specific product reviewed"
    },
    "productName": {
      "type": "string"
    },
    "reviewerName": {
      "type": "string"
    },
    "reviewerEmail": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Star rating 1\u20135"
    },
    "feedback": {
      "type": "string",
      "description": "Written feedback"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "True if linked to a confirmed order"
    },
    "helpful": {
      "type": "number",
      "default": 0,
      "description": "Helpful vote count"
    }
  },
  "required": [
    "artisanId",
    "artisanName",
    "reviewerName",
    "rating",
    "feedback"
  ]
}