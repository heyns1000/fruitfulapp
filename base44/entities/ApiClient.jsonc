{
  "name": "ApiClient",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "key_hash": {
      "type": "string"
    },
    "key_prefix": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_used_at": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "key_hash"
  ]
}