{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "brandId": {
      "type": "string",
      "description": "Brand this subscription is for"
    },
    "brandName": {
      "type": "string",
      "description": "Brand name"
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "professional",
        "enterprise"
      ],
      "description": "Subscription plan tier"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "cancelled",
        "expired"
      ],
      "default": "active"
    },
    "billingCycle": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "annual"
      ],
      "default": "monthly"
    },
    "amount": {
      "type": "number",
      "description": "Subscription amount per cycle (ZAR)"
    },
    "currency": {
      "type": "string",
      "default": "ZAR"
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "nextBillingDate": {
      "type": "string",
      "format": "date"
    },
    "gateway": {
      "type": "string",
      "enum": [
        "PayFast",
        "Ozow",
        "Yoco",
        "PayPal",
        "Paystack"
      ]
    },
    "paymentToken": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sector": {
      "type": "string",
      "description": "Linked sector key (e.g. creative, fashion)"
    },
    "subnodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Linked brand subnodes included in this subscription"
    },
    "linkedProductIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MarketplaceService IDs bundled with this subscription tier"
    },
    "pricingFormula": {
      "type": "object",
      "description": "Cost-price-linked pricing formula (ZAR ex-works basis)",
      "properties": {
        "costPriceZAR": {
          "type": "number",
          "description": "Ex-works cost price in ZAR"
        },
        "wholesaleMarkupPct": {
          "type": "number",
          "description": "Wholesale markup % above cost",
          "default": 40
        },
        "retailMarkupPct": {
          "type": "number",
          "description": "Retail markup % above wholesale",
          "default": 80
        },
        "onlineMarkupPct": {
          "type": "number",
          "description": "Online/subscription markup % above cost",
          "default": 60
        },
        "vatPct": {
          "type": "number",
          "description": "VAT %",
          "default": 15
        },
        "shippingZAR": {
          "type": "number",
          "description": "Fixed shipping cost ZAR",
          "default": 0
        }
      }
    },
    "tierLimits": {
      "type": "object",
      "description": "What is included per tier",
      "properties": {
        "maxProducts": {
          "type": "number"
        },
        "maxOrdersPerMonth": {
          "type": "number"
        },
        "discountPct": {
          "type": "number",
          "description": "Subscriber discount on products"
        },
        "freeShipping": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "autoRenew": {
          "type": "boolean",
          "default": true
        },
        "trialEndsAt": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "plan",
    "amount",
    "billingCycle",
    "gateway"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}