{
  "name": "ComplianceAudit",
  "type": "object",
  "properties": {
    "vaultId": {
      "type": "string",
      "description": "Vault being audited"
    },
    "vaultName": {
      "type": "string",
      "description": "Vault name"
    },
    "auditType": {
      "type": "string",
      "enum": [
        "POPIA",
        "GDPR",
        "PCI-DSS",
        "Comprehensive"
      ],
      "description": "Type of compliance audit"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "warning",
        "in_progress"
      ],
      "default": "in_progress",
      "description": "Audit status"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Risk level assessment"
    },
    "complianceScore": {
      "type": "number",
      "description": "Overall compliance score (0-100)"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "regulation": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      },
      "description": "List of violations found"
    },
    "findings": {
      "type": "object",
      "properties": {
        "encryption": {
          "type": "object",
          "properties": {
            "compliant": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          }
        },
        "accessControl": {
          "type": "object",
          "properties": {
            "compliant": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          }
        },
        "dataResidency": {
          "type": "object",
          "properties": {
            "compliant": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          }
        },
        "auditTrail": {
          "type": "object",
          "properties": {
            "compliant": {
              "type": "boolean"
            },
            "details": {
              "type": "string"
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "AI-generated recommendations"
    },
    "aiAnalysis": {
      "type": "string",
      "description": "Detailed AI analysis of compliance posture"
    }
  },
  "required": [
    "vaultId",
    "vaultName",
    "auditType"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}