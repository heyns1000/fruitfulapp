{
  "name": "Metrics",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When these metrics were recorded"
    },
    "activeNodes": {
      "type": "number",
      "description": "Number of active nodes"
    },
    "licensesActive": {
      "type": "number",
      "description": "Number of active licenses"
    },
    "vaultDeployments": {
      "type": "number",
      "description": "Number of vault deployments"
    },
    "syncLogs": {
      "type": "number",
      "description": "Number of sync logs"
    },
    "auditsRunning": {
      "type": "number",
      "description": "Number of running audits"
    },
    "signalZones": {
      "type": "number",
      "description": "Number of signal zones"
    },
    "scrollGridIndex": {
      "type": "number",
      "description": "Scroll grid index count"
    }
  },
  "required": [
    "timestamp"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}