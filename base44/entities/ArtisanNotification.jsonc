{
  "name": "ArtisanNotification",
  "type": "object",
  "properties": {
    "artisanId": {
      "type": "string"
    },
    "artisanName": {
      "type": "string"
    },
    "artisanEmail": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "order_received",
        "package_received",
        "review_posted",
        "new_order"
      ],
      "description": "Notification type"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "orderNumber": {
      "type": "string"
    },
    "buyerName": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "artisanId",
    "type",
    "title",
    "message"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.artisanEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.artisanEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}