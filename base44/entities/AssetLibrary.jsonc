{
  "name": "AssetLibrary",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Asset name / label"
    },
    "assetType": {
      "type": "string",
      "enum": [
        "logo",
        "product_photo",
        "color_palette",
        "document",
        "spreadsheet",
        "pdf",
        "file"
      ],
      "description": "Type of asset"
    },
    "folder": {
      "type": "string",
      "enum": [
        "commerce",
        "banimal",
        "artisan",
        "subscriptions",
        "brands",
        "creative",
        "infrastructure",
        "branding"
      ],
      "default": "brands",
      "description": "Folder category matching Dashboard navigation tabs"
    },
    "brandId": {
      "type": "string",
      "description": "Associated brand ID"
    },
    "brandName": {
      "type": "string",
      "description": "Associated brand name"
    },
    "fileUrl": {
      "type": "string",
      "description": "Uploaded file URL (for logos, product photos, documents, spreadsheets)"
    },
    "description": {
      "type": "string",
      "description": "Short description of the asset for AI context"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable tags"
    },
    "colorValues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hex": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "description": "Color swatches for color_palette type"
    },
    "sourceEntity": {
      "type": "string",
      "description": "Entity where this asset was discovered (for auto-imported assets)"
    }
  },
  "required": [
    "name",
    "assetType"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}