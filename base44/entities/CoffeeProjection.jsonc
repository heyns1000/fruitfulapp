{
  "name": "CoffeeProjection",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "ISO date string for projection month"
    },
    "cups_to_sell": {
      "type": "number"
    },
    "coffee_profit": {
      "type": "number"
    },
    "recurring_costs": {
      "type": "number"
    },
    "once_off_costs": {
      "type": "number"
    },
    "net_profit": {
      "type": "number"
    },
    "scenario": {
      "type": "string",
      "default": "base"
    }
  },
  "required": [
    "month"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}