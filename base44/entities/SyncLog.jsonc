{
  "name": "SyncLog",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "pull",
        "push"
      ]
    },
    "resource": {
      "type": "string"
    },
    "record_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "direction",
    "resource"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}