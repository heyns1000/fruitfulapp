# Development placeholders — the app boots with these. Real secrets in
# /run/base44/app.env (delivered by the platform) override them.
VITE_BASE44_APP_ID=6953a072de46207f94f2b9d2
# Base URL left unset on purpose: with it set, the app reaches its live backend,
# which answers 403 auth_required, and the app then redirects the preview to the
# Base44 login page (off-origin), leaving the preview blank. Unset => the app
# renders its UI with empty data. Set it to https://app.base44.com to wire the
# live backend (the user then logs in).
# VITE_BASE44_APP_BASE_URL=https://app.base44.com
